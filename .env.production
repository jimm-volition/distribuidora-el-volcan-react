# Se usa en "npm run build" (despliegue en AWS).
# Rutas relativas: React y las dos API se publican en el mismo dominio detras de Nginx,
# asi el build sirve aunque cambie la IP publica de la instancia EC2.
#   /auth-service/...     -> Auth    (127.0.0.1:8081)
#   /pedidos-service/...  -> Pedidos (127.0.0.1:8082)
VITE_AUTH_URL=/auth-service
VITE_API_URL=/pedidos-service
